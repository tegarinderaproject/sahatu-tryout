# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut ke GitHub. Jangan pernah tempel kunci rahasia di chat.

# Supabase > Project Settings > Data API (atau menu "Connect") > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (diawali sb_publishable_)
# (Kalau yang muncul masih "anon public" key, itu juga boleh dipakai di sini.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Kunci rahasia server (Secret key / service_role). Belum dipakai di Tahap 1.
# Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
